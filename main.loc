module vector (*)

import root

-- Vector shares its memory representation with the generic List (`Vector n a`
-- is a List `[a]` at the wire level), so it interoperates with List-typed
-- code. The differences from List:
--   * the Nat parameter `n` enables compile-time dimensional typechecking
--   * each language backend maps Vector to its high-performance unboxed
--     numeric array (std::vector, numpy.ndarray, R atomic vector), avoiding
--     boxed-object overhead
--
-- This makes Vector the canonical 1D dense numeric container: the columnar
-- building block for tables and the rank-1 base for higher-rank tensors.
--
-- Gradual dimensional annotation:
--   The Nat parameter is opt-in. Users who don't care about the length
--   can omit it entirely:
--     * `Vector 3 U8`   -- concrete, exactly 3 elements
--     * `Vector n U8`   -- polymorphic, caller determines the length
--     * `Vector U8`     -- gradual, no length claim
--   All three coexist. A concrete `Vector 3 U8` can flow into a
--   `Vector U8` slot and vice-versa (the subtype rule treats a missing
--   Nat as wildcard-compatible with any concrete Nat). Het-length
--   containers work naturally: `[Vector U8]` accepts elements of
--   different lengths because each element's Nat is independent.
--
--   Use `size v :: U64` from the `Sizeable` class to query length at
--   runtime regardless of which annotation form the signature uses.

--' n-element 1D dense array.
--' metavar: VECTOR
newtype Vector (n :: Nat) a = List a

-- Graded concat: (vec1 ++ vec2) :: Vector m a -> Vector n a -> Vector (m+n) a
-- Replaces the prior closed Semigroup/Monoid instances which lied about
-- the result dim being the same as the input dim.
instance SemigroupDim Vector
instance MonoidDim Vector
instance Functor (Vector n)
instance Foldable (Vector n)
instance Eq (Vector n a)
instance Ord (Vector n a)

-- Bracket access: myVec[i] via Indexable (Vector n).
instance Indexable (Vector n)

-- Bracket slice: myVec[1:3] :: Vector m a. The result dim is unrelated
-- to the input dim (m is a fresh Nat variable that the typechecker
-- unifies based on use-site context).
instance SliceableDim Vector

-- Required for constructin Vectors from list literals
instance Packable (List a) (Vector n a)

-- Elementwise arithmetic. The shared `n` is the point: two vectors can only
-- be combined when the type already says they are the same length, which is
-- stronger than the List version can express. Deriving a column from two
-- others -- `ac / an` -- is the most ordinary thing a table program does.
--
-- `zero` is not implementable here: it would have to produce a vector of a
-- length nothing supplies. Methods resolve per use site, so the operators
-- are usable and only `zero` at a Vector is an error. `zeros1` takes the
-- length as an argument and is what you want instead.
instance Integral a => Integral (Vector n a)
instance Numeric a => Numeric (Vector n a)

-- Elementwise conversion to Real. This cannot be a `RealLike` instance:
-- that class returns a scalar `Real`, so an instance at Vector would mean
-- collapsing the vector to one number. Without it a derived column has to
-- go back through a list to change its element type, which undoes the
-- point of the arithmetic instances above.
realOf :: Vector n a -> Vector n Real

-- Construction (zero-filled)
zeros1 :: d@Int -> Vector d a

-- Construction (one-filled)
ones1 :: d@Int -> Vector d a

-- Construction (filled with given value)
fill1 :: a -> d@Int -> Vector d a
